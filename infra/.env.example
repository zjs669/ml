# 交付编排的环境变量。先复制成 .env 再改口令与密钥：
#   cp .env.example .env
# 注意：.env 已在 .gitignore 里，绝不能提交到仓库。

# ---- 对外端口 ----
WEB_PORT=8080

# ---- 应用 ----
APP_ENV=development
SECRET_KEY=dev-only-change-me-please-use-32-bytes-min
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:8080

# ---- 数据库（容器内部网络，不对外暴露端口）----
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=xuanshu
MYSQL_APP_USER=xuanshu_app
MYSQL_APP_PASSWORD=change_this_app_password

# ---- 模型 ----
# mock：确定性本地生成，离线可测；openai_compatible：接真实模型
# 生产环境 APP_ENV=production 时会拒绝 mock 与占位 key，直接启动失败
LLM_MODE=mock
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace_with_secret
LLM_MODEL=replace_with_authorized_model
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000
# 当日模型调用次数熔断，0 表示不限
LLM_DAILY_TOTAL_BUDGET=500
# 模型不支持 response_format 时改成 prompt_only
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
# 页脚公示（模型名称 + 备案号），留空不展示
LLM_MODEL_DISCLOSURE=
# 计价（元 / 千 token），两项为 0 则不估算成本
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# ---- 额度与支付 ----
DAILY_FREE_REPORT_LIMIT=1
MOCK_PAYMENT_SECRET=mock-webhook-secret-change-me
