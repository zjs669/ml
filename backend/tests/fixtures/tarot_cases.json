      },
      "expect": {
        "pool_size": 78,
        "card_count": 3
      }
    },
    {
      "case_id": "tarot-002-major-single",
      "input": {
        "spread": "single",
        "deck": "major",
        "seed": "case-2"
      },
      "expect": {
        "pool_size": 22,
        "card_count": 1
      }
    },
    {
      "case_id": "tarot-003-minor-celtic",
      "input": {
        "spread": "celtic",
        "deck": "minor",
        "seed": "case-3"
      },
      "expect": {
        "pool_size": 56,
        "card_count": 10
      }
    },
    {
      "case_id": "tarot-004-custom",
      "input": {
        "spread": "situation",
        "deck": "all",
        "seed": "case-4",
        "custom_positions": [
          "甲",
          "乙",
          "丙",
          "丁"
        ]
      },
      "expect": {
        "pool_size": 78,
        "card_count": 4
