# 本文件只是模板：服务只加载 `.env`（同目录）
# 如需本地运行，复制为 .env 并填入真实值（.env 已在 .gitignore 中）

# ---- 应用 ----
APP_ENV=development
APP_NAME=玄枢国学研习台
API_PREFIX=/api/v1
SECRET_KEY=dev-only-change-me-please-use-32-bytes-min
# 密钥静态加密主密钥（≥32 字符）。生成：python -c "import secrets;print(secrets.token_urlsafe(36))"
# 丢失后已加密的 LLM_API_KEY / SMTP_PASSWORD 将无法解开，必须重新加密
SECRETS_MASTER_KEY=
# 外部技能包（只读，不复制进仓库）；多个用逗号分隔。留空则不加载
# 典型值：D:/瞎玩/taibu/skills/taibu-divination
SKILLS_EXTRA_DIRS=
# 报告/追问是否也读外部技能包（外部包含断语口径，默认关，保持本项目红线）
SKILLS_EXTERNAL_IN_PRODUCT=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库（本地独立开发实例，端口 3307）----
# 项目默认的开发实例：独立 datadir，避免影响系统里已存在的 MySQL8 服务
DATABASE_URL=mysql+pymysql://xuanshu_app:XuanShuDev_2026@127.0.0.1:3307/xuanshu?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://xuanshu_app:XuanShuDev_2026@127.0.0.1:3307/xuanshu_test?charset=utf8mb4

# ---- 模型 ----
# mock = 确定性本地生成（默认，内容为盘面事实模板）；openai_compatible = 真实模型
LLM_MODE=mock
LLM_PROVIDER=openai_compatible
# 任意 OpenAI 兼容服务，必须以 /v1 结尾（例：https://api.deepseek.com/v1 或 http://127.0.0.1:7863/v1）
LLM_BASE_URL=https://api.example.com/v1
# 不要提交真实 key；留空或保持占位值时，服务会明确标记为演示模型而不是静默降级
LLM_API_KEY=replace_with_secret
LLM_MODEL=replace_with_authorized_model
LLM_MAX_OUTPUT_TOKENS=6000
# 长报告 + 慢模型时适当放大超时（秒）
LLM_TIMEOUT_SECONDS=180
# 当日模型调用总次数上限（熔断阈值），0 表示不限制
LLM_DAILY_TOTAL_BUDGET=500
# json_object = 发送 response_format（默认）；prompt_only = 只用提示词约束（部分国产模型会拒收 response_format）
LLM_JSON_MODE=json_object
LLM_TEMPERATURE=0.2
# 页脚公示用的模型名称与备案号，留空则不展示
LLM_MODEL_DISCLOSURE=
# 计价（元 / 千 token），两项都为 0 则不估算成本
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# ---- 视觉模型（面相 / 手相）----
# 留空则回落到上面的 LLM_* 配置；视觉模型通常与文本模型不同（且更贵），建议单配
# 三项（BASE_URL / API_KEY / MODEL）都填齐才算配置完成，否则接口直接返回 503 而不是悄悄用文本模型
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_VISION_TIMEOUT_SECONDS=120
LLM_VISION_MAX_OUTPUT_TOKENS=4000

# ---- 图片存储（面相 / 手相）----
# 图片落盘根目录，留空则用 backend/var/media
MEDIA_ROOT=
# 单张图片上限（字节），默认 5 MiB
MEDIA_MAX_BYTES=5242880
# 图片留存天数，到期由清理脚本删除
MEDIA_RETENTION_DAYS=30

# ---- 额度与付费 ----
DAILY_FREE_REPORT_LIMIT=1
REPORT_DATA_RETENTION_DAYS=90
# 生产环境必须换成强随机值，否则启动自检会直接失败
MOCK_PAYMENT_SECRET=mock-webhook-secret-change-me

# ---- 账号安全 ----
# 重置令牌有效期与同时可用数量
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_ACTIVE=3
# 同账号连续失败锁定（按账号，不受换 IP 影响）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 重置邮件里链接指向的前端地址
FRONTEND_BASE_URL=http://localhost:5173
# 限流开关：生产必须为 true；本地反复跑 smoke_e2e 时可临时置 false
RATELIMIT_ENABLED=true

# ---- 邮件通道（忘记密码）----
# console = 写 backend/var/mail_outbox.log（开发默认，不真实投递）
# smtp    = 走真实邮件服务器，生产必须用这个
MAIL_MODE=console
MAIL_FROM=no-reply@xuanshu.local
MAIL_OUTBOX_PATH=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
